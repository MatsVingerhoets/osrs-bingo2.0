NODE_ENV=production
PORT=3000

APP_NAME=OSRS Bingo 2.0
APP_BASE_URL=https://your-public-domain.example
VITE_APP_NAME=OSRS Bingo 2.0
VITE_APP_BASE_URL=https://your-public-domain.example

DATABASE_URL=postgres://prod_user:prod_password@prod-postgres-host:5432/osrs_bingo_prod
SESSION_SECRET=replace-with-a-long-random-secret
SESSION_MAX_AGE_SECONDS=28800

KEYCLOAK_ISSUER_URL=https://keycloak.example.com/realms/your-realm
KEYCLOAK_CLIENT_ID=osrs-bingo-web
KEYCLOAK_CLIENT_SECRET=replace-with-your-client-secret
KEYCLOAK_USERNAME_CLAIM=preferred_username
