### --- Project Identity ---
APP_NAME=OSRS Bingo 2.0    # App name shown in metadata and the UI
APP_DIR=app                # Inside-container app folder
APP_BASE_URL=http://localhost:3000

### --- App Port ---
APP_PORT=3000              # Host port -> container:3000
VITE_APP_NAME=OSRS Bingo 2.0
VITE_APP_BASE_URL=http://localhost:3000

### --- App Runtime ---
DATABASE_URL=postgres://postgres:@postgres:5432/osrs_bingo_db?sslmode=disable
SESSION_SECRET=replace-me-with-a-long-random-string
SESSION_MAX_AGE_SECONDS=28800
KEYCLOAK_ISSUER_URL=https://keycloak.example.com/realms/osrs-bingo
KEYCLOAK_CLIENT_ID=osrs-bingo-web
KEYCLOAK_CLIENT_SECRET=replace-me
KEYCLOAK_USERNAME_CLAIM=preferred_username

### --- Database ---
POSTGRES_VERSION=17        # Postgres version to use
DB_USER=postgres
DB_PASSWORD=
DB_NAME=your_app_db
DB_PORT=5432               # Must be unique per project (5432, 5433, 5434...)

POSTGRES_HOST_AUTH_METHOD=trust

### --- Dotfiles (Optional) ---
# For your Neovim + Zsh setup (set to your host paths, e.g., /Users/you/.zshrc)
ZSHRC_PATH=
NEOVIM_CONFIG_PATH=
GITCONFIG_PATH=

### --- pgAdmin (ONLY if enabling per-project pgAdmin service) ---
#PGADMIN_EMAIL=you@example.com
#PGADMIN_PASSWORD=secret
#PGADMIN_PORT=8080
